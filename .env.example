STRIPE_SECRET_KEY="sk_test_... from Stripe dashboard, Developers, API keys (test mode)"
STRIPE_WEBHOOK_SECRET="whsec_... from `stripe listen` or the webhook endpoint in the Stripe dashboard"
STRIPE_PRICE_MONTHLY="price_... id of the $8 monthly Pro price"
STRIPE_PRICE_YEARLY="price_... id of the $72 yearly Pro price"
